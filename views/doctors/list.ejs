<%- include('../partials/header') %>

<h4 class="mb-3">Referring Doctors <a href="/doctors/commissions" class="btn btn-sm btn-outline-primary float-end">View Commissions</a></h4>

<div class="row">
  <div class="col-md-5">
    <div class="card p-3 mb-3">
      <h6>Add Doctor</h6>
      <form method="POST" action="/settings/doctors/new">
        <div class="mb-2"><input name="name" class="form-control" placeholder="Doctor Name" required></div>
        <div class="mb-2"><input name="clinic" class="form-control" placeholder="Clinic / Hospital"></div>
        <div class="mb-2"><input name="phone" class="form-control" placeholder="Phone"></div>
        <div class="mb-2"><input name="email" class="form-control" placeholder="Email"></div>
        <div class="mb-2"><input type="number" step="0.01" name="commission_percent" class="form-control" placeholder="Commission %"></div>
        <button class="btn btn-primary btn-sm">Add</button>
      </form>
    </div>
  </div>
  <div class="col-md-7">
    <div class="card p-3">
      <div class="table-responsive">
<table class="table table-sm">
        <thead><tr><th>Name</th><th>Clinic</th><th>Phone</th><th>Commission</th></tr></thead>
        <tbody>
          <% doctors.forEach(d => { %>
            <tr><td>Dr. <%= d.name %></td><td><%= d.clinic || '-' %></td><td><%= d.phone || '-' %></td><td><%= d.commission_percent %>%</td></tr>
          <% }) %>
          <% if (doctors.length === 0) { %><tr><td colspan="4" class="text-muted text-center">No doctors added yet.</td></tr><% } %>
        </tbody>
      </table>
</div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
