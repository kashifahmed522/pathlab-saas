<%- include('../partials/header') %>

<h4 class="mb-3">Billing Overview</h4>

<div class="row g-3 mb-3">
  <div class="col-6 col-md-3">
    <div class="card stat-card p-3">
      <div class="text-muted small">Total Billed</div>
      <div class="fs-4 fw-bold">₹<%= totals.total.toFixed(2) %></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card p-3">
      <div class="text-muted small">Total Collected</div>
      <div class="fs-4 fw-bold text-success">₹<%= totals.paid.toFixed(2) %></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card p-3">
      <div class="text-muted small">Outstanding</div>
      <div class="fs-4 fw-bold text-danger">₹<%= (totals.total - totals.paid).toFixed(2) %></div>
    </div>
  </div>
</div>

<div class="card p-3">
  <div class="table-responsive">
<table class="table table-sm align-middle">
    <thead><tr><th>Invoice No</th><th>Order</th><th>Patient</th><th>Total</th><th>Paid</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% invoices.forEach(inv => { %>
        <tr>
          <td><%= inv.invoice_no %></td>
          <td><%= inv.order_no %></td>
          <td><%= inv.patient_name %></td>
          <td>₹<%= Number(inv.total).toFixed(2) %></td>
          <td>₹<%= Number(inv.paid_amount).toFixed(2) %></td>
          <td><span class="badge <%= inv.status==='paid' ? 'bg-success' : inv.status==='partial' ? 'bg-warning text-dark' : 'bg-danger' %>"><%= inv.status %></span></td>
          <td><a href="/orders/<%= inv.order_id %>" class="btn btn-sm btn-outline-primary">Open Order</a></td>
        </tr>
      <% }) %>
      <% if (invoices.length === 0) { %><tr><td colspan="7" class="text-muted text-center">No invoices yet.</td></tr><% } %>
    </tbody>
  </table>
</div>
</div>

<%- include('../partials/footer') %>
