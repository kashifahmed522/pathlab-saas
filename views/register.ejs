<%- include('partials/header') %>

<div class="row justify-content-center mt-4">
  <div class="col-md-5">
    <div class="card p-4">
      <h4 class="mb-1 text-center">Register Your Lab</h4>
      <p class="text-center text-muted small">Start a free trial in under a minute — no credit card required.</p>
      <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>
      <form method="POST" action="/register">
        <div class="mb-2">
          <label class="form-label">Lab Name</label>
          <input type="text" name="lab_name" class="form-control" placeholder="e.g. Sunrise Diagnostics" required>
        </div>
        <div class="mb-2">
          <label class="form-label">Lab Short Code <small class="text-muted">(used in order numbers, e.g. SUN)</small></label>
          <input type="text" name="lab_code" class="form-control" maxlength="8" placeholder="SUN" required>
        </div>
        <hr>
        <div class="mb-2">
          <label class="form-label">Admin Name</label>
          <input type="text" name="admin_name" class="form-control" required>
        </div>
        <div class="mb-2">
          <label class="form-label">Admin Email</label>
          <input type="email" name="email" class="form-control" required>
        </div>
        <div class="mb-2">
          <label class="form-label">Phone</label>
          <input type="text" name="phone" class="form-control">
        </div>
        <div class="mb-3">
          <label class="form-label">Password</label>
          <input type="password" name="password" class="form-control" required minlength="6">
        </div>
        <button class="btn btn-primary w-100">Create Lab & Start</button>
      </form>
      <p class="text-center mt-3 mb-0">Already have an account? <a href="/login">Login</a></p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
