<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>PathLab SaaS<%= typeof currentUser !== 'undefined' && currentUser ? ' | ' + currentUser.lab_name : '' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
<% if (typeof currentUser !== 'undefined' && currentUser) { %>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
  <div class="container-fluid">
    <a class="navbar-brand fw-bold" href="/dashboard">🧪 PathLab <span class="opacity-75 fs-6">| <%= currentUser.lab_name %></span></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" href="/dashboard">Dashboard</a></li>
        <li class="nav-item"><a class="nav-link" href="/patients">Patients</a></li>
        <li class="nav-item"><a class="nav-link" href="/orders">Orders</a></li>
        <li class="nav-item"><a class="nav-link" href="/orders/new">+ New Order</a></li>
        <li class="nav-item"><a class="nav-link" href="/billing">Billing</a></li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Settings</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="/settings/tests">Test Catalog</a></li>
            <li><a class="dropdown-item" href="/settings/doctors">Referring Doctors</a></li>
            <li><a class="dropdown-item" href="/doctors/commissions">Doctor Commissions</a></li>
            <li><a class="dropdown-item" href="/settings/users">Staff / Users</a></li>
            <li><a class="dropdown-item" href="/settings/lab">Lab Profile & Billing</a></li>
          </ul>
        </li>
      </ul>
      <span class="navbar-text text-white-50 me-3"><%= currentUser.name %> · <span class="badge bg-light text-dark"><%= currentUser.role %></span></span>
      <a href="/logout" class="btn btn-outline-light btn-sm">Logout</a>
    </div>
  </div>
</nav>
<% } %>
<div class="container pb-5">
