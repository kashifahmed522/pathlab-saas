<%- include('../partials/header') %>

<h4 class="mb-3">Edit Test</h4>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
<div class="card p-4" style="max-width:600px;">
  <form method="POST" action="/settings/tests/<%= test.id %>/edit">
    <div class="row">
      <div class="col-4 mb-2"><label class="form-label">Code</label><input name="code" class="form-control" value="<%= test.code %>" required></div>
      <div class="col-8 mb-2"><label class="form-label">Name</label><input name="name" class="form-control" value="<%= test.name %>" required></div>
    </div>
    <div class="row">
      <div class="col-6 mb-2"><label class="form-label">Category</label><input name="category" class="form-control" value="<%= test.category || '' %>"></div>
      <div class="col-6 mb-2"><label class="form-label">Sample Type</label><input name="sample_type" class="form-control" value="<%= test.sample_type || '' %>"></div>
    </div>
    <div class="row">
      <div class="col-4 mb-2"><label class="form-label">Price (₹)</label><input type="number" step="0.01" name="price" class="form-control" value="<%= test.price %>" required></div>
      <div class="col-4 mb-2"><label class="form-label">Unit</label><input name="unit" class="form-control" value="<%= test.unit || '' %>"></div>
      <div class="col-4 mb-2"><label class="form-label">TAT (hours)</label><input type="number" name="tat_hours" class="form-control" value="<%= test.tat_hours %>"></div>
    </div>
    <div class="mb-2"><label class="form-label">Reference Range</label><input name="reference_range" class="form-control" value="<%= test.reference_range || '' %>"></div>
    <div class="mb-3"><label class="form-label">Method</label><input name="method" class="form-control" value="<%= test.method || '' %>"></div>
    <div class="d-flex gap-2">
      <button class="btn btn-primary">Save Changes</button>
      <a href="/settings/tests" class="btn btn-outline-secondary">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
