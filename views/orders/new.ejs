<%- include('../partials/header') %>

<h4 class="mb-3">New Order</h4>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

<form method="POST" action="/orders/new" id="orderForm">
  <div class="row">
    <div class="col-md-6">
      <div class="card p-3 mb-3">
        <h6>Patient & Doctor</h6>
        <div class="mb-2">
          <label class="form-label">Patient</label>
          <select name="patient_id" class="form-select" required>
            <option value="">-- Select patient --</option>
            <% patients.forEach(p => { %>
              <option value="<%= p.id %>" <%= selectedPatientId === p.id ? 'selected' : '' %>><%= p.name %> (<%= p.uhid %>)</option>
            <% }) %>
          </select>
          <a href="/patients/new" class="small">+ register a new patient</a>
        </div>
        <div class="mb-2">
          <label class="form-label">Referring Doctor</label>
          <select name="doctor_id" class="form-select">
            <option value="">Self / Walk-in</option>
            <% doctors.forEach(d => { %>
              <option value="<%= d.id %>">Dr. <%= d.name %> <%= d.clinic ? '('+d.clinic+')' : '' %> <%= d.commission_percent > 0 ? '· ' + d.commission_percent + '% commission' : '' %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-check mb-2">
          <input class="form-check-input" type="checkbox" name="home_collection" value="1" id="hc">
          <label class="form-check-label" for="hc">Home Sample Collection</label>
        </div>
        <div class="mb-2">
          <label class="form-label">Collection Address</label>
          <textarea name="collection_address" class="form-control"></textarea>
        </div>
        <div class="row">
          <div class="col-6 mb-2">
            <label class="form-label">Discount (₹)</label>
            <input type="number" step="0.01" name="discount" id="discount" class="form-control" value="0">
          </div>
          <div class="col-6 mb-2">
            <label class="form-label">Tax / GST (%)</label>
            <input type="number" step="0.01" name="tax_percent" id="taxPercent" class="form-control" value="<%= lab.default_tax_percent || 0 %>">
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card p-3 mb-3">
        <h6>Select Tests</h6>
        <div style="max-height: 360px; overflow-y:auto;">
        <% let cat = null; tests.forEach(t => { %>
          <% if (t.category !== cat) { cat = t.category; %>
            <div class="fw-bold small text-muted mt-2"><%= cat || 'General' %></div>
          <% } %>
          <div class="form-check">
            <input class="form-check-input test-checkbox" type="checkbox" name="test_ids" value="<%= t.id %>" data-price="<%= t.price %>" id="test<%= t.id %>">
            <label class="form-check-label d-flex justify-content-between" for="test<%= t.id %>" style="width: 95%;">
              <span><%= t.name %> <small class="text-muted">(<%= t.sample_type %>)</small></span>
              <span>₹<%= Number(t.price).toFixed(0) %></span>
            </label>
          </div>
        <% }) %>
        </div>

        <div class="border-top mt-3 pt-2">
          <div class="d-flex justify-content-between"><span>Subtotal</span><span id="sumSubtotal">₹0.00</span></div>
          <div class="d-flex justify-content-between text-muted"><span>Discount</span><span id="sumDiscount">− ₹0.00</span></div>
          <div class="d-flex justify-content-between text-muted"><span>Tax</span><span id="sumTax">+ ₹0.00</span></div>
          <div class="d-flex justify-content-between fw-bold fs-5 border-top mt-1 pt-1"><span>Total</span><span id="sumTotal">₹0.00</span></div>
        </div>
      </div>
    </div>
  </div>

  <button class="btn btn-primary full-width-mobile">Create Order & Generate Invoice</button>
</form>

<script>
  function recalc() {
    const checked = document.querySelectorAll('.test-checkbox:checked');
    let subtotal = 0;
    checked.forEach(c => subtotal += parseFloat(c.dataset.price || 0));
    const discount = parseFloat(document.getElementById('discount').value || 0);
    const taxPct = parseFloat(document.getElementById('taxPercent').value || 0);
    const taxable = Math.max(subtotal - discount, 0);
    const tax = taxable * (taxPct / 100);
    const total = taxable + tax;
    document.getElementById('sumSubtotal').textContent = '₹' + subtotal.toFixed(2);
    document.getElementById('sumDiscount').textContent = '− ₹' + discount.toFixed(2);
    document.getElementById('sumTax').textContent = '+ ₹' + tax.toFixed(2);
    document.getElementById('sumTotal').textContent = '₹' + total.toFixed(2);
  }
  document.querySelectorAll('.test-checkbox').forEach(c => c.addEventListener('change', recalc));
  document.getElementById('discount').addEventListener('input', recalc);
  document.getElementById('taxPercent').addEventListener('input', recalc);
  recalc();
</script>

<%- include('../partials/footer') %>
